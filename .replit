VITE_PHONE_NUMBER = "6299649429"
VITE_WHATSAPP_NUMBER = "6299649429"
EMAIL_FROM = "mechengineersoft@gmail.com"

[nix]
channel = "stable-25_05"
packages = ["zammad"]
